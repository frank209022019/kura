{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kura",
  "version": "../package.json",
  "identifier": "io.github.frankgrobbelaar.kura",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kura",
        "width": 1280,
        "height": 832,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0b0c0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kura",
    "category": "Video",
    "shortDescription": "Organise, check and upscale an anime library",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/frankgrobbelaar/kura/releases/latest/download/latest.json"],
      "pubkey":"dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNkFGQjI2Q0Y4QTM2NkIKUldSck5vclBKdnRxRUt6V05IckU3OVd5bis5KzJrR1F4U1hvRXhVVXcwNXllVHlVaHN0RU1EY3cK",
      "windows": { "installMode": "passive" }
    }
  }
}
