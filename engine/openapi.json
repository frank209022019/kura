{
  "openapi": "3.1.0",
  "info": {
    "title": "Kura engine",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/tools": {
      "get": {
        "summary": "Tools",
        "description": "What Kura downloads to work with, and whether each is ready.",
        "operationId": "tools_tools_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Tool"
                  },
                  "type": "array",
                  "title": "Response Tools Tools Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/tools/{tool_id}/download": {
      "post": {
        "summary": "Download",
        "description": "Starts downloading a tool, unless it's ready or already on its way.",
        "operationId": "download_tools__tool_id__download_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tool_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tool Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tool"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "dataDir": {
            "type": "string",
            "title": "Datadir"
          },
          "schemaVersion": {
            "type": "integer",
            "title": "Schemaversion"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "dataDir",
          "schemaVersion"
        ],
        "title": "Health"
      },
      "State": {
        "type": "string",
        "enum": [
          "missing",
          "downloading",
          "unpacking",
          "ready",
          "failed"
        ]
      },
      "Tool": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose"
          },
          "licence": {
            "type": "string",
            "title": "Licence"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "done": {
            "type": "integer",
            "title": "Done"
          },
          "problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "purpose",
          "licence",
          "size",
          "state",
          "done",
          "problem"
        ],
        "title": "Tool"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
