            "type": "integer",
            "title": "Schemaversion"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "dataDir",
          "schemaVersion"
        ],
        "title": "Health"
      },
      "Library": {
        "properties": {
          "folders": {
            "type": "integer",
            "title": "Folders"
          },
          "files": {
            "type": "integer",
            "title": "Files"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "unread": {
            "type": "integer",
            "title": "Unread"
          },
          "problems": {
            "type": "integer",
            "title": "Problems"
          },
          "sd": {
            "type": "integer",
            "title": "Sd"
