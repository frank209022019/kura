          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose"
          },
          "licence": {
            "type": "string",
            "title": "Licence"
          },
          "size": {
            "type": "integer",
            "title": "Size"
