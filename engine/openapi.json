        "required": [
          "state",
          "stage",
          "startedAt",
          "finishedAt",
          "found",
          "toRead",
          "read",
          "problems",
          "current",
          "secondsLeft",
          "unavailable",
          "problem",
          "titles",
          "waiting",
          "note"
        ],
        "title": "Scan"
