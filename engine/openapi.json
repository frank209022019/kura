            "title": "Naming",
            "default": "plex"
          },
          "upscaleSd": {
            "type": "boolean",
            "title": "Upscalesd",
            "default": true
          },
          "upscale720": {
            "type": "boolean",
            "title": "Upscale720",
            "default": true
          },
          "setUp": {
            "type": "boolean",
            "title": "Setup",
            "default": false
          }
        },
        "type": "object",
        "title": "Settings"
      },
