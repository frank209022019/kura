      "Settings": {
        "properties": {
          "standard": {
            "type": "string",
            "enum": [
              "cinema-1080",
              "compact-720"
            ],
            "title": "Standard",
            "default": "cinema-1080"
          },
          "naming": {
            "type": "string",
            "enum": [
              "plex",
              "jellyfin",
              "keep"
