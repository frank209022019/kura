        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "addedAt": {
            "type": "string",
            "title": "Addedat"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "files": {
            "type": "integer",
            "title": "Files"
          },
          "unread": {
            "type": "integer",
            "title": "Unread"
          },
          "problems": {
            "type": "integer",
            "title": "Problems"
