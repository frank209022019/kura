          },
          "toRead": {
            "type": "integer",
            "title": "Toread"
          },
          "read": {
            "type": "integer",
            "title": "Read"
          },
          "problems": {
            "type": "integer",
            "title": "Problems"
          },
          "current": {
            "anyOf": [
